# Database (Neon / Supabase / local PostgreSQL)
DATABASE_URL=postgresql://postgres:[password]@localhost:5432/shift4

# Auth - generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# API-key encryption at rest - generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Base URL used in e-mail links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail (login one-time codes + status notifications) - required for login
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Supabase Storage (statement PDFs) - service role is server-side only
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI (fallback when no key is set in Settings)
ANTHROPIC_API_KEY=sk-ant-your-key

# Docker only: Postgres password and first-run bootstrap (see README)
POSTGRES_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_INVITE_CODE=
